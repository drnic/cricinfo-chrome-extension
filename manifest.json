{
  "manifest_version": 3,
  "name": "Cricinfo Tweaks",
  "version": "0.2.0",
  "description": "Makes Cricinfo nicer to read. Removes ads.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Cricinfo Tweaks",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.cricinfo.com/*",
        "https://www.espncricinfo.com/*"
      ],
      "css": ["src/hide-ads.css", "src/commentary.css"],
      "js": ["src/settings.js", "src/content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
